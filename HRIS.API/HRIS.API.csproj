<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>5d350293-35ce-4ba8-b9b7-8e88597df716</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EntityFrameworkCore.CommonTools" Version="2.0.2" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
        <PackageReference Include="MailKit" Version="4.*" />
        <PackageReference Include="MediatR" Version="12.*" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog.AspNetCore" Version="10.*" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
        <None Update="Templates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Features\Departments\Commands\" />
    </ItemGroup>

</Project>
